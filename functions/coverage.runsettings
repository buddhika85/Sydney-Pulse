<?xml version="1.0" encoding="utf-8"?>
<!-- Coverlet settings: what code the coverage report ignores.
     Rule: exclude only generated code and code with no logic. Real gaps stay visible. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>
            <!-- Generated by protoc from GtfsRealtime.proto -->
            [SydneyPulse.Core]TransitRealtime.*,

            <!-- Generated by the Azure Functions worker SDK -->
            [SydneyPulse.Functions]SydneyPulse.Functions.DirectFunctionExecutor,
            [SydneyPulse.Functions]SydneyPulse.Functions.FunctionExecutorAutoStartup,
            [SydneyPulse.Functions]SydneyPulse.Functions.FunctionExecutorHostBuilderExtensions,
            [SydneyPulse.Functions]SydneyPulse.Functions.FunctionMetadataProviderAutoStartup,
            [SydneyPulse.Functions]SydneyPulse.Functions.GeneratedFunctionMetadataProvider,
            [SydneyPulse.Functions]SydneyPulse.Functions.WorkerExtensionStartupCodeExecutor,
            [SydneyPulse.Functions]SydneyPulse.Functions.WorkerHostBuilderFunctionMetadataProviderExtension,

            <!-- Startup wiring, no logic -->
            [SydneyPulse.Functions]Program,

            <!-- Plain options classes, no logic -->
            [SydneyPulse.Functions]SydneyPulse.Functions.CosmosOptions,
            [SydneyPulse.Functions]SydneyPulse.Functions.EventGridOptions,

            <!-- Throwaway spike, kept but not tested -->
            [SydneyPulse.Functions]SydneyPulse.Functions.AzFunctions.Spikes.SpikeFunction
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>